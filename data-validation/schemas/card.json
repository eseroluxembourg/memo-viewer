{
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "content": {
            "type": "string",
            "pattern": "^\\s*$"
        },
        "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "lot": {
                    "type": "string"
                },
                "num": {
                    "type": ["number", "string"]
                },
                "variants": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "isFrontOnly": {
                    "type": "boolean"
                }
            },
            "required": ["variants", "num", "lot"]
        }
    },
    "required": ["content", "data"]
}