{
    "name": "memo-viewer",
    "version": "1.16.0",
    "private": true,
    "scripts": {
        "dev": "node server.mjs",
        "dev:app": "node server.mjs",
        "dev:admin": "cd admin && npm run dev",
        "build:admin": "cd admin && npm run build",
        "install:admin": "npm install&&cd admin && npm install",
        "install:app": "npm install",
        "test:admin": "cd admin && npm run test",
        "test": "vitest",
        "test:report": "vitest --coverage --reporter junit --outputFile=report.xml",
        "prod": "export NODE_ENV=production && node server.mjs",
        "build": "vite build",
        "vite": "vite",
        "serve:docs": "docsify serve docs",
        "build:client": "vite build --ssrManifest --outDir dist/client",
        "build:server": "vite build --ssr src/entry-server.mjs --outDir dist/server",
        "preview": "vite preview --outDir dist/server",
        "generate:app": "export TODAY=$(date -Iseconds);vite build --ssrManifest --outDir dist/static && npm run build:server && mv dist/static/index.html dist/static/app.html && node --max-old-space-size=8292 prerender.mjs && rm dist/static/ssr-manifest.json",
        "generate": "npm run generate:app",
        "prettier:check": "prettier --check .",
        "prettier:write": "prettier --write .",
        "tolgit:install": "cd .tolgee; npm install",
        "tolgit:pull": "node .tolgee/node_modules/tolgitbot/cli.mjs pull -i .tolgee/tolgitinterface.js",
        "tolgit:push": "node .tolgee/node_modules/tolgitbot/cli.mjs push -i .tolgee/tolgitinterface.js",
        "lint": "eslint 'src/*.js' 'src/**/*.js'",
        "cy:open": "cypress open"
    },
    "dependencies": {
        "@heroicons/vue": "^2.0.18",
        "@nuxt/devalue": "^2.0.2",
        "ajv": "^8.12.0",
        "compression": "^1.7.4",
        "express": "^4.18.2",
        "gray-matter": "^4.0.3",
        "lodash.set": "^4.3.2",
        "pinia": "^2.0.32",
        "swiper": "^9.2.0",
        "tolgitbot": "git+https://framagit.org/Marc-AntoineA/tolgitbot.git",
        "vis-data": "^7.1.6",
        "vis-network": "^9.1.6",
        "vue": "^3.2.47",
        "vue-i18n": "^9.9.0",
        "vue-matomo": "^4.2.0",
        "vue-router": "^4.2.5"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.0.1",
        "@typescript-eslint/parser": "^8.0.1",
        "@vitejs/plugin-vue": "^4.0.0",
        "@vitest/coverage-v8": "^2.1.1",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "cypress": "^13.14.2",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.27.0",
        "markdown-it": "^14.0.0",
        "markdown-it-footnote": "^4.0.0",
        "prettier": "3.0.3",
        "sass": "^1.62.0",
        "typescript": "^5.4.5",
        "vite": "^4.1.4",
        "vite-plugin-eslint": "^1.8.1",
        "vitest": "^2.1.1"
    }
}
